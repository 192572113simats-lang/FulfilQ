# Server & Environment
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Database: "sqlite" (default zero-config fallback) or "postgres"
DB_DIALECT="sqlite"
SQLITE_PATH="./data/fulfilliq.db"
CSV_DIR="./data/csv"
DATABASE_URL="postgres://fulfilliq:fulfilliq_dev@localhost:5432/fulfilliq"

# Security & Auth
JWT_SECRET="replace-with-strong-random-secret-in-production"
JWT_EXPIRES_IN="8h"

# Operational Policies (defaults, overridden per-region in DB config)
RESERVATION_EXPIRY_MINUTES=15

# Payment Gateway Adapter: "local_stub" (default) or "sandbox_http"
PAYMENT_GATEWAY_MODE="local_stub"
SANDBOX_GATEWAY_URL="http://localhost:4010/v1/charges"
SANDBOX_GATEWAY_API_KEY="sandbox_test_key"
SANDBOX_GATEWAY_TIMEOUT_MS=3000
